rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: read the caller's role once from Firestore
    function myRole() {
      return firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.role;
    }

    // Superuser has every permission, including settings/custom pages.
    function isSuperuser() {
      return isAuthenticated() && myRole() == 'superuser';
    }

    // Helper: Check if user is an admin (or superuser)
    function isAdmin() {
      return isAuthenticated() && (myRole() == 'admin' || isSuperuser());
    }

    // Helper: Check if user is the owner of the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Avatars collection
    match /avatars/{userId}/{fileName} {
      // Profiles are visible to all authenticated users
      allow read: if isAuthenticated();
      
      // Users can only upload and delete their own avatars
      allow write: if isOwner(userId)
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Event Gallery Photos & Videos
    match /events/{eventId}/photos/{fileName} {
      // Photos/videos are visible to all authenticated users
      allow read: if isAuthenticated();

      // All authenticated users can upload photos (max 10MB) or videos (max 100MB)
      allow create: if isAuthenticated()
                    && (
                      (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
                      ||
                      (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024)
                    );

      // Only the uploader or an admin can delete the file
      // Note: resource.metadata contains the customMetadata we set during upload
      allow delete: if isAuthenticated()
                    && (resource.metadata.uploadedById == request.auth.uid || isAdmin());
    }
    
    // Member Vehicle Photos
    match /vehicles/{memberId}/{fileName} {
      // Vehicle photos are visible to everyone (showcase)
      allow read: if true;

      // Only the vehicle's owner or an admin can upload/delete its photos
      allow create: if (isOwner(memberId) || isAdmin())
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(memberId) || isAdmin();
    }

    // Page Content Images (About Us, etc.)
    match /pages/{pageId}/{fileName} {
      // Images on pages are visible to all users
      allow read: if true;
      
      // Only superusers can upload and delete images for pages
      allow create, update: if isSuperuser()
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if isSuperuser();
    }

    // Application assets (logo, etc.)
    match /app/{fileName} {
      // Logos are visible to all users (even unauthenticated)
      allow read: if true;

      // Only superusers can upload and manage app assets
      allow write: if isSuperuser()
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
    
    // Default: Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
