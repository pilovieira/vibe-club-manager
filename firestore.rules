rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
  	function isAuth() {
    	return request.auth != null;
    }
    
    // Helper to read the caller's role once
    function myRole() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role;
    }

    // Superuser has every permission, including settings/custom pages.
    function isSuperuser() {
      return isAuth() && myRole() == 'superuser';
    }

    // Admin: general admin permissions (members, events, logbook), also granted to superuser.
    function isAdmin() {
      return isAuth() && (myRole() == 'admin' || isSuperuser());
    }

    // Finance: financial admin pages only, also granted to admin/superuser.
    function isFinance() {
      return isAuth() && (myRole() == 'financeiro' || isAdmin());
    }
    
    match /members/{memberId} {
      // Allow reading member info if authenticated OR if viewing public event context
      // Simplified: allow read for everyone but only for specific fields would be better,
      // but Firestore rules are limited. We'll allow read if authenticated or via a public check.
      // For now, allow read for public to support avatars in public events.
      allow read: if true; 
      
     // Create Rule:
      allow create: if isAuth() && (
        isAdmin() || 
        (
          request.auth.uid == memberId && 
          request.resource.data.role == 'member'
        )
      );
      
      // Update Logic:
      allow update: if isAuth() && (
        (
          isAdmin() &&
          // Only a superuser can grant the superuser role itself.
          (request.resource.data.role != 'superuser' || isSuperuser())
        ) ||
        (
          request.auth.uid == memberId &&
          // Members can't change their own role or dues exemption.
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isExempt'])
        )
      );
    }
    
    // Properties / Settings
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if isSuperuser();
    }
    
    // Events & Core data
    match /events/{eventId} {
      allow read: if isAuth() || resource.data.visibility == 'public';
      allow write: if isAdmin();
    }
    
    match /event_attendees/{id} {
      // Allow reading attendees if authenticated OR if the event is public
      allow read: if isAuth() || get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.visibility == 'public';
      allow create: if isAuth() && (request.resource.data.member_id == request.auth.uid || isAdmin());
      allow delete: if isAuth() && (resource.data.member_id == request.auth.uid || isAdmin());
    }

    match /event_photos/{photoId} {
      // Allow reading photos if authenticated OR if the event is public
      allow read: if isAuth() || get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.visibility == 'public';
      allow create: if isAuth() && request.resource.data.uploaded_by_id == request.auth.uid;
      allow delete: if isAuth() && (resource.data.uploaded_by_id == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Member vehicles showcase
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isAuth() && (request.resource.data.member_id == request.auth.uid || isAdmin());
      allow update, delete: if isAuth() && (resource.data.member_id == request.auth.uid || isAdmin());
    }

    match /contributions/{id} {
      allow read: if isAuth() && (resource.data.member_id == request.auth.uid || isFinance());
      allow write: if isFinance();
    }

    match /global_transactions/{id} {
      allow read, write: if isFinance();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isSuperuser();
    }
    
    // LogBook collection
    match /logs/{logId} {
      allow read: if isAdmin();
      // A user can only ever log actions as themselves, never impersonate another member.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}